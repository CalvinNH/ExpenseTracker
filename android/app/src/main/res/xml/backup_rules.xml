<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup rules (API < 31).
  Excludes the EncryptedSharedPreferences file used by flutter_secure_storage
  from cloud backup. The database encryption key is hardware-bound and must
  never leave the device.
-->
<full-backup-content>
    <exclude domain="sharedpref"
             path="FlutterSecureStorage" />
</full-backup-content>
